<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    Reference the CVApp source files directly so the service layer types are
    available without a project reference to the BlazorWebAssembly SDK project.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\ContentManagement\ContentManagement.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\CVApp\Services\ExperienceDataService.cs" LinkBase="Services" />
    <Compile Include="..\..\src\CVApp\Services\PrintConfigurationService.cs" LinkBase="Services" />
    <Compile Include="..\..\src\CVApp\Services\SkillHighlightService.cs" LinkBase="Services" />
    <Compile Include="..\..\src\CVApp\Services\CvAdminStoreService.cs" LinkBase="Services" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.28" />
  </ItemGroup>

</Project>
