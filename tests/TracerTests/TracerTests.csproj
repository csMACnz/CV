<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Path to the CVApp project root, used by tracer tests to invoke build/publish commands -->
    <CVAppProjectPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../src/CVApp/CVApp.csproj'))</CVAppProjectPath>
    <!-- Repository root, passed to tests so they can locate content and resolve publish output -->
    <RepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../'))</RepositoryRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Pass project paths as compile-time constants so tests can locate them without hard-coding paths -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>CVAppProjectPath</_Parameter1>
      <_Parameter2>$(CVAppProjectPath)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RepositoryRoot</_Parameter1>
      <_Parameter2>$(RepositoryRoot)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
