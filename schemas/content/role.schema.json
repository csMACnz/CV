{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://csmac.nz/schemas/content/role.schema.json",
  "title": "Role Content",
  "type": "object",
  "additionalProperties": false,
  "required": ["title"],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "start": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
    },
    "end": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
    }
  }
}
