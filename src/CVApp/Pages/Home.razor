@page "/"
@page "/experience"
@inject ExperienceDataService ExperienceDataService
@inject SkillHighlightService SkillHighlightService
@inject PrintConfigurationService PrintConfigurationService
@inject IJSRuntime JS

<PageTitle>Experience</PageTitle>

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <p class="experience-shell__status" role="alert">@ErrorMessage</p>
}
else if (CvData is null)
{
    <p class="experience-shell__status" role="status">Loading experience...</p>
}
else
{
    <div class="experience-shell">
        <ProfileHeader Data="@CvData.Profile" PrintRequested="@OpenPrintConfigModal" />
        <SkillMatrix Skills="@AllSkills"
                     ActiveSkill="@ActiveSkill"
                     ActiveSkillChanged="@OnActiveSkillChanged" />
        <TimelineFeed Entries="@FilteredTimeline" Highlights="@CurrentHighlights" />
    </div>
}

@if (IsPrintConfigModalOpen)
{
    <PrintConfigModal Configuration="@PrintConfigurationService.Current"
                      CancelRequested="@ClosePrintConfigModal"
                      GeneratePrintRequested="@GeneratePrintAsync" />
}

@code {
    private ExperiencePayload? CvData;
    private string? ErrorMessage;
    private string? ActiveSkill;
    private IReadOnlyList<string> AllSkills = [];
    private HighlightMap CurrentHighlights = HighlightMap.Empty;
    private bool IsPrintConfigModalOpen;
    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Today);

    private IReadOnlyList<TimelineEntry> FilteredTimeline => CvData is null
        ? []
        : PrintConfigurationService.FilterTimelineEntries(
            CvData.Timeline,
            PrintConfigurationService.Current.TimelineScope,
            Today);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            CvData = await ExperienceDataService.GetExperienceAsync();
            if (CvData is null)
            {
                ErrorMessage = "Experience data is unavailable right now.";
            }
            else
            {
                AllSkills = SkillHighlightService.GetAllSkills(CvData.Timeline);
            }
        }
        catch
        {
            ErrorMessage = "Experience data could not be loaded.";
        }
    }

    private void OnActiveSkillChanged(string? skill)
    {
        ActiveSkill = skill;
        CurrentHighlights = CvData is not null
            ? SkillHighlightService.BuildHighlightMap(CvData.Timeline, skill)
            : HighlightMap.Empty;
    }

    private void OpenPrintConfigModal()
    {
        IsPrintConfigModalOpen = true;
    }

    private void ClosePrintConfigModal()
    {
        IsPrintConfigModalOpen = false;
    }

    private async Task GeneratePrintAsync(PrintConfiguration configuration)
    {
        PrintConfigurationService.Update(configuration);
        IsPrintConfigModalOpen = false;
        await InvokeAsync(StateHasChanged);
        await JS.InvokeVoidAsync("cvApp.printCv");
    }
}
