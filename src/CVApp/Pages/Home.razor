@page "/"
@page "/experience"
@inject ExperienceDataService ExperienceDataService
@inject SkillHighlightService SkillHighlightService

<PageTitle>Experience</PageTitle>

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <p class="experience-shell__status" role="alert">@ErrorMessage</p>
}
else if (CvData is null)
{
    <p class="experience-shell__status" role="status">Loading experience...</p>
}
else
{
    <div class="experience-shell">
        <ProfileHeader Data="@CvData.Profile" />
        <SkillMatrix Skills="@AllSkills"
                     ActiveSkill="@ActiveSkill"
                     ActiveSkillChanged="@OnActiveSkillChanged" />
        <TimelineFeed Entries="@CvData.Timeline" Highlights="@CurrentHighlights" />
    </div>
}

@code {
    private ExperiencePayload? CvData;
    private string? ErrorMessage;
    private string? ActiveSkill;
    private IReadOnlyList<string> AllSkills = [];
    private HighlightMap CurrentHighlights = HighlightMap.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            CvData = await ExperienceDataService.GetExperienceAsync();
            if (CvData is null)
            {
                ErrorMessage = "Experience data is unavailable right now.";
            }
            else
            {
                AllSkills = SkillHighlightService.GetAllSkills(CvData.Timeline);
            }
        }
        catch
        {
            ErrorMessage = "Experience data could not be loaded.";
        }
    }

    private void OnActiveSkillChanged(string? skill)
    {
        ActiveSkill = skill;
        CurrentHighlights = CvData is not null
            ? SkillHighlightService.BuildHighlightMap(CvData.Timeline, skill)
            : HighlightMap.Empty;
    }
}
