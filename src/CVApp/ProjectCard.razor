@using CVApp.Services

<div class="project-card @(IsHighlighted ? "is-highlighted" : string.Empty)">
    <div class="project-card__header">
        <h4 class="project-card__name">@Project.Name</h4>
        @if (!string.IsNullOrWhiteSpace(Project.Narrative) || !string.IsNullOrWhiteSpace(Project.BriefSummary))
        {
            <button type="button"
                    class="card-expand-toggle no-print"
                    aria-expanded="@_expanded.ToString().ToLowerInvariant()"
                    @onclick="ToggleExpand">
                <span class="card-expand-toggle__label">@(_expanded ? "Collapse" : "Expand / Deep Dive")</span>
                <span class="card-expand-toggle__icon" aria-hidden="true">@(_expanded ? "−" : "+")</span>
            </button>
        }
    </div>
    @if (_expanded && !string.IsNullOrWhiteSpace(Project.Narrative))
    {
        <p class="project-card__narrative">@Project.Narrative</p>
    }
    @if (!_expanded && !string.IsNullOrWhiteSpace(Project.BriefSummary))
    {
        <p class="project-card__narrative project-card__summary">@Project.BriefSummary</p>
    }
    @if (Project.Skills.Count > 0)
    {
        <ul class="project-card__skills" aria-label="Skills">
            @foreach (var skill in Project.Skills)
            {
                <li class="project-card__skill-pill">@skill</li>
            }
        </ul>
    }
</div>

@code {
    private bool _expanded = true;

    [Parameter, EditorRequired]
    public Project Project { get; set; } = default!;

    [Parameter]
    public bool IsHighlighted { get; set; }

    private void ToggleExpand()
    {
        _expanded = !_expanded;
    }
}
