@using CVApp.Services

<div class="timeline-feed" aria-label="Experience timeline">
    @if (_yearMarkers.Count > 0)
    {
        <div class="timeline-feed__year-markers" aria-hidden="true">
            @foreach (var marker in _yearMarkers)
            {
                <div class="timeline-feed__year-marker" style="@($"--timeline-marker-position: {marker.Position};")">
                    <span class="timeline-feed__year-label">@marker.Year</span>
                </div>
            }
        </div>
    }

    <div class="timeline-feed__entries">
        @foreach (var entry in Entries)
        {
            <TimelineCard Entry="@entry" Highlights="@Highlights" />
        }
    </div>
</div>

@code {
    private IReadOnlyList<TimelineYearMarker> _yearMarkers = [];

    [Parameter, EditorRequired]
    public IReadOnlyList<TimelineEntry> Entries { get; set; } = default!;

    [Parameter]
    public HighlightMap Highlights { get; set; } = HighlightMap.Empty;

    protected override void OnParametersSet()
    {
        _yearMarkers = TimelineYearMarkerBuilder.Build(Entries, DateOnly.FromDateTime(DateTime.Today));
    }
}
