@using CVApp.Services

<div class="timeline-feed" aria-label="Experience timeline">
    @if (_yearMarkers.Count > 0)
    {
        <div class="timeline-feed__year-markers" aria-hidden="true">
            @foreach (var marker in _yearMarkers)
            {
                <div class="timeline-feed__year-marker" style="@($"--timeline-marker-position: {marker.Position};")">
                    <span class="timeline-feed__year-label">@marker.Year</span>
                </div>
            }
        </div>
    }

    <div class="timeline-feed__entries">
        @foreach (var entry in Entries)
        {
            <TimelineCard Entry="@entry" Highlights="@Highlights" />
        }
    </div>
</div>

@code {
    private IReadOnlyList<TimelineYearMarker> _yearMarkers = [];

    [Parameter, EditorRequired]
    public IReadOnlyList<TimelineEntry> Entries { get; set; } = default!;

    [Parameter]
    public HighlightMap Highlights { get; set; } = HighlightMap.Empty;

    [Parameter]
    public DateOnly? ReferenceDate { get; set; }

    protected override void OnParametersSet()
    {
        _yearMarkers = TimelineYearMarkerBuilder.Build(Entries, ReferenceDate ?? ResolveReferenceDate(Entries));
    }

    private static DateOnly ResolveReferenceDate(IReadOnlyList<TimelineEntry> entries)
    {
        var explicitEndDates = entries
            .SelectMany(entry => entry.Roles)
            .Select(role => TryParseTimelineDate(role.End))
            .Where(date => date.HasValue)
            .Select(date => date!.Value)
            .ToList();

        if (explicitEndDates.Count > 0)
            return explicitEndDates.Max();

        var startDates = entries
            .SelectMany(entry => entry.Roles)
            .Select(role => TryParseTimelineDate(role.Start))
            .Where(date => date.HasValue)
            .Select(date => date!.Value)
            .ToList();

        return startDates.Count > 0 ? startDates.Max() : DateOnly.MinValue;
    }

    private static DateOnly? TryParseTimelineDate(string? rawValue)
    {
        return TimelineDateParser.TryParse(rawValue ?? string.Empty, out var parsedDate)
            ? parsedDate
            : null;
    }
}
