<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ContentRoot>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..', '..', 'content'))</ContentRoot>
    <ExperienceJsonOutput>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', 'wwwroot', 'data', 'experience.json'))</ExperienceJsonOutput>
    <ReleaseBaseHref Condition="'$(ReleaseBaseHref)' == ''">/</ReleaseBaseHref>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.28" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.28" PrivateAssets="all" />
  </ItemGroup>

  <!--
    Build-time aggregation step: compiles modular YAML/Markdown content files
    into a single static experience.json payload for production publishing.
    Runs in Release configuration as part of the Publish pipeline.
  -->
  <!--
    ADR-004 / ADR-011: Exclude admin-only Razor components from Release builds entirely.
    This ensures the /admin route is not registered in production WASM artifacts.
  -->
  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Content Remove="Pages\AdminDashboard.razor" />
    <Content Remove="Pages\ProfileEditForm.razor" />
    <Content Remove="Pages\SkillMatrixManager.razor" />
  </ItemGroup>

  <Target Name="AggregateExperienceJson" BeforeTargets="BeforeBuild" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <AggregationProject>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..', 'Aggregation', 'Aggregation.csproj'))</AggregationProject>
      <ExperienceJsonOutputNormalized>$(ExperienceJsonOutput.Replace('\','/'))</ExperienceJsonOutputNormalized>
      <ContentRootNormalized>$(ContentRoot.Replace('\','/'))</ContentRootNormalized>
    </PropertyGroup>
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(ExperienceJsonOutput)'))" />
    <Exec Command="dotnet run --project &quot;$(AggregationProject)&quot; --configuration Release -- &quot;$(ContentRootNormalized)&quot; &quot;$(ExperienceJsonOutputNormalized)&quot;"
          WorkingDirectory="$(MSBuildThisFileDirectory)" />
  </Target>

  <!--
    Verify that the aggregated experience.json payload is present before publishing.
    Fails the publish step if the artifact is missing or incorrectly named.
  -->
  <Target Name="VerifyExperienceJsonArtifact" AfterTargets="AggregateExperienceJson" Condition="'$(Configuration)' == 'Release'">
    <Error Condition="!Exists('$(ExperienceJsonOutput)')"
           Text="Publish verification failed: expected artifact not found at '$(ExperienceJsonOutput)'. The experience.json payload must be produced by the aggregation step before publishing." />
    <Message Importance="high" Text="Publish verification passed: $(ExperienceJsonOutput) exists." />
  </Target>

  <Target Name="ApplyReleaseBaseHref" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <PublishedIndexPath>$([MSBuild]::NormalizePath('$(PublishDir)', 'wwwroot', 'index.html'))</PublishedIndexPath>
    </PropertyGroup>
    <XmlPoke XmlInputPath="$(PublishedIndexPath)" Query="/html/head/base/@href" Value="$(ReleaseBaseHref)" />
    <Message Importance="high" Text="Updated published index base href to '$(ReleaseBaseHref)' at '$(PublishedIndexPath)'." />
  </Target>

</Project>
